defaults: debug level fast  = false 3 true
set debug true, level 7  = true 7
get_bool undefined  = EXN Failure("flags_get_bool: flag nope not defined")
set_bool undefined  = EXN Failure("flags_set: flag nope not defined")
get_int on a bool flag  = EXN Failure("flags_get_int: invalid value type for flag debug")
set_expr "debug=no,level=12,fast=YES"  = false 12 true
set_expr "level=x"  = EXN Failure("flags_set_expr: invalid value specified for flag level")
set_expr "level" (no =)  = EXN Failure("flags_set_expr: no equals sign found in expression level")
set_expr "nope=3" (undefined flag)  = EXN Failure("flags_set: flag nope not defined")
set_expr "nope=true" (undefined flag)  = EXN Failure("flags_set: flag nope not defined")
set_int on a bool flag  = EXN Failure("flags_set: flag fast is a Boolean flag")
  then get_bool fast  = true
  then get_int fast  = EXN Failure("flags_get_int: invalid value type for flag fast")
flags_empty: get_bool x  = EXN Failure("flags_get_bool: flag x not defined")
flags_empty: set_bool x  = EXN Failure("flags_set: flag x not defined")
set_bool on an int flag  = EXN Failure("flags_set: flag n is an integer flag")
get_bool on an int flag  = EXN Failure("flags_get_bool: invalid value type for flag n")
get_int undefined  = EXN Failure("flags_get_int: flag nope not defined")
set_expr "b=f" then get_bool b  = false
set_expr "b=t" then get_bool b  = true
--- begin print_std_flag_defaults
new:  A section with no flags.

opt:  Optimizer flags.
   fast                           = false
      go fast when the input is large enough to matter
   depth                          = 2
      how deep the search goes before it gives up; a larger depth finds more
      and takes longer, and past twenty it rarely pays

other:  other
   b                              = true
      no help available
   n                              = 4
      no help available

--- end print_std_flag_defaults
--- begin print_std_flag_values
===begin current state===
Flag name                        Current value
b                              = true
depth                          = 9
=== end current state ===
--- end print_std_flag_values
