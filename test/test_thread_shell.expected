get_pid (root)  = (id,1)
get_pids (root is hidden)  = []
create a, a, h (hidden), b  = [(a,1); (a,2); (h,1); (b,1)]
get_pids  = [(a,1); (b,1); (a,2)]
get_pid after create (unchanged)  = (id,1)
with_pid a2 get_pid  = (a,2)
make_pid a 2  = (a,2)
make_pid a 9  = EXN Not_found
make_pid id 1 (root)  = (id,1)
create_or_find a 1 (exists)  = (a,1)
create_or_find c 5 (new)  = (c,5)
create_or_find c 5 again  = (c,5)
set_pid b; get_pid  = (b,1)
with_current get_pid  = (b,1)
with_pid a1 get_pid (from b)  = (a,1)
get_pid after with_pid  = (b,1)
set_pid to an unknown pid  = EXN Not_found
get_pids at the end  = [(a,1); (b,1); (a,2); (c,5)]
