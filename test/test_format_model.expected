margin 1000, hbox [a; cut; b]  = "a b" (Format "ab")
margin 1000, hbox [a; break 3 1; b]  = "a b" (Format "a   b")
margin 1000, hovbox [a; break 3 1; b]  = "a b" (Format "a   b")
