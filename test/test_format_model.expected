default margin, max_indent, max_boxes, ellipsis  = 80 4611686018427387903 4611686018427387903 "..."
after setting 40, 20, 2, "%%"  = 40 20 2 "%%"
over_max_boxes with 0, 1, 2, 3 boxes open (max 2)  = false false true true
boxes nested past max_boxes 2 print the ellipsis  = "abcd"
make_formatter: what the output functions receive  = "x=3 y=z\n", 1 flush(es)
str_formatter, flush_str_formatter twice  = "a-1" ""
tbox: set_tab, print_tab, print_tbreak  = "abcdef  gh"
