SS.of_list [b;a;c;a] = ["a"; "b"; "c"]
SS.cardinal a = 3
SS.union a b = ["a"; "b"; "c"; "d"]
SS.inter a b = ["c"]
SS.diff a b = ["a"; "b"]
SS.subset {c} a = true
SS.mem a "b" = true
SS.remove a "b" = ["a"; "c"]
SS.remove absent a "z" = ["a"; "b"; "c"]
SS.min/max a = a c
SS.min_elt empty = EXN Not_found
SS.compare sign a b = -1
SS.equal a (of_list [c;b;a]) = true
SS.fold concat a = abc
IS.partition even [5;1;4;2;3] = [2; 4] [1; 3; 5]
IS.filter >2 [5;1;4;2;3] = [3; 4; 5]
IS 1000 permuted adds cardinal min max = 1000 0 999
SM.add (a twice)  = [a=10; b=2; c=3]
SM.find "a" = 10
SM.find absent "z" = EXN Not_found
SM.keys  = ["a"; "b"; "c"]
SM.data  = [10; 2; 3]
SM.remove "b" = [a=10; c=3]
SM.filter_add "a" +1, "z" new = [a=11; b=2; c=3; z=99]
SM.union sum  = [a=15; b=2; c=3]
SM.cardinal  = 3
