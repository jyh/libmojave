StringSet.elements words = ["a"; "fig"; "kiwi"; "pear"; "apple"; "banana"]
LexStringSet.elements words = ["a"; "apple"; "banana"; "fig"; "kiwi"; "pear"]
StringTable keys words -> length = ["a"; "fig"; "kiwi"; "pear"; "apple"; "banana"]
StringTable.find fig  = 3
StringTable.find plum  = EXN Not_found
LexStringTable keys words -> length = ["a"; "apple"; "banana"; "fig"; "kiwi"; "pear"]
MTable add x1 y2 x3 zz4 x5; cardinal  = 3
  find x  = 5
  find_all x  = [5; 3; 1]
  find_all w (absent)  = []
  find_all_partial w (absent)  = EXN Not_found
  keys  = ["x"; "y"; "zz"]
  data  = [5; 3; 1; 2; 4]
  data_all  = [[5; 3; 1]; [2]; [4]]
  choose_all  = x [5; 3; 1]
  remove x; find_all x  = []
  remove x; cardinal  = 2
  filter x (> 1); find_all x  = [5; 3]
  filter x to []; mem x  = false
  iter_all  = [x:[5; 3; 1]; y:[2]; zz:[4]]
  iter  = [x=5; y=2; zz=4]
  fold_all (count values)  = 5
  mapi_all (double, drop y)  = [[10; 6; 2]; []; [8]]
  mapi_all leaving y with []: mem y, cardinal  = true 3
  ... find y  = EXN Not_found
  ... find_all y  = []
  ... data  = [5; 3; 1; 4]
  union (a @ b) with x10 q11; elements via find_all  = [q:[11]; x:[5; 3; 1; 10]; y:[2]; zz:[4]]
LexStringMTable keys, find_all x  = ["x"; "y"; "zz"] [5; 3; 1]
