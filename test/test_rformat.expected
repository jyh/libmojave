text plain w=80 = "hello world"
text plain w=20 = "hello world"
text plain w=10 = "hello world"
text plain w=4 = "hello world"
text spaces w=80 = "word1 word2 word3 word4 word5 word6 word7 word8"
text spaces w=20 = "word1\nword2\nword3\nword4\nword5\nword6 word7 word8"
text spaces w=10 = "word1\nword2\nword3\nword4\nword5\nword6\nword7\nword8"
text spaces w=4 = "word1\nword2\nword3\nword4\nword5\nword6\nword7\nword8"
text hzone hbreak w=80 = "item1\nitem2\nitem3\nitem4\nitem5\nitem6"
text hzone hbreak w=20 = "item1\nitem2\nitem3\nitem4\nitem5\nitem6"
text hzone hbreak w=10 = "item1\nitem2\nitem3\nitem4\nitem5\nitem6"
text hzone hbreak w=4 = "item1\nitem2\nitem3\nitem4\nitem5\nitem6"
text szone sbreak w=80 = "item1 item2 item3 item4 item5 item6"
text szone sbreak w=20 = "item1\nitem2\nitem3\nitem4 item5 item6"
text szone sbreak w=10 = "item1\nitem2\nitem3\nitem4\nitem5\nitem6"
text szone sbreak w=4 = "item1\nitem2\nitem3\nitem4\nitem5\nitem6"
text lzone w=80 = "word1 word2 word3 word4 word5 word6"
text lzone w=20 = "word1 word2 word3 word4 word5 word6"
text lzone w=10 = "word1 word2 word3 word4 word5 word6"
text lzone w=4 = "word1 word2 word3 word4 word5 word6"
text cbreak w=80 = "f\\argument_one;argument_two"
text cbreak w=20 = "f\\argument_one\n,argument_two"
text cbreak w=10 = "f\n(argument_one\n,argument_two"
text cbreak w=4 = "f\n(argument_one\n,argument_two"
text pushm 2 w=80 = "let x = word1 word2 word3 word4 word5"
text pushm 2 w=20 = "let x =\n  word1\n  word2\n  word3 word4 word5"
text pushm 2 w=10 = "let x =\n  word1\n  word2\n  word3\n  word4\n  word5"
text pushm 2 w=4 = "let x =\nword1\nword2\nword3\nword4\nword5"
text pushm_str w=80 = "word1 word2 word3 word4 word5 word6"
text pushm_str w=20 = "word1\n  word2\n  word3\n  word4 word5 word6"
text pushm_str w=10 = "word1\n  word2\n  word3\n  word4\n  word5\n  word6"
text pushm_str w=4 = "word1\nword2\nword3\nword4\nword5\nword6"
text nested w=80 = "outer\nword1 word2 word3 word4\nend"
text nested w=20 = "outer\nword1\nword2 word3 word4\nend"
text nested w=10 = "outer\nword1\nword2\nword3\nword4\nend"
text nested w=4 = "outer\nword1\nword2\nword3\nword4\nend"
text newline w=80 = "a\nb"
text newline w=20 = "a\nb"
text newline w=10 = "a\nb"
text newline w=4 = "a\nb"
text atoms w=80 = "-42 123456789012345678901234567890 \"q\" raw"
text atoms w=20 = "-42\n123456789012345678901234567890\n\"q\" raw"
text atoms w=10 = "-42\n123456789012345678901234567890\n\"q\" raw"
text atoms w=4 = "-42\n123456789012345678901234567890\n\"q\"\nraw"
text izone w=80 = "visINVISIBLEible"
text izone w=20 = "visINVISIBLEible"
text izone w=10 = "visINVISIBLEible"
text izone w=4 = "visINVISIBLEible"
text tzone w=80 = "tagged after"
text tzone w=20 = "tagged after"
text tzone w=10 = "tagged after"
text tzone w=4 = "tagged after"
text format_buffer w=80 = "[word1 word2 word3]"
text format_buffer w=20 = "[word1 word2 word3]"
text format_buffer w=10 = "[word1\nword2\nword3]"
text format_buffer w=4 = "[word1\nword2\nword3]"
printer plain w=20 = S"hello" S" " S"world"
printer spaces w=20 = S"word1" T0""[] S"" S"word2" T0""[] S"" S"word3" T0""[] S"" S"word4" T0""[] S"" S"word5" T0""[] S"" S"word6" S" " S"word7" S" " S"word8"
printer hzone hbreak w=20 = S"item1" T0""[] S"" S"item2" T0""[] S"" S"item3" T0""[] S"" S"item4" T0""[] S"" S"item5" T0""[] S"" S"item6"
printer szone sbreak w=20 = S"item1" T0""[] S"" S"item2" T0""[] S"" S"item3" T0""[] S"" S"item4" S" " S"item5" S" " S"item6"
printer lzone w=20 = S"word1" S" " S"word2" S" " S"word3" S" " S"word4" S" " S"word5" S" " S"word6"
printer cbreak w=20 = S"f" S"\\" S"argument_one" T0""[] S"," S"argument_two"
printer pushm 2 w=20 = S"let x =" T2"  "[] S"" S"word1" T2"  "[] S"" S"word2" T2"  "[] S"" S"word3" S" " S"word4" S" " S"word5"
printer pushm_str w=20 = S"word1" T2"> "[] S"" S"word2" T2"> "[] S"" S"word3" T2"> "[] S"" S"word4" S" " S"word5" S" " S"word6"
printer nested w=20 = S"outer" T0""[] S"" S"word1" T0""[] S"" S"word2" S" " S"word3" S" " S"word4" T0""[] S"" S"end"
printer newline w=20 = S"a" T0""[] S"b"
printer atoms w=20 = S"-42" T0""[] S"" S"123456789012345678901234567890" T0""[] S"" S"\"" S"q" S"\"" S" " S"raw"
printer izone w=20 = S"vis" I"INVISIBLE" S"ible"
printer tzone w=20 = <tag S"tagged" >tag S" after"
printer format_buffer w=20 = S"[" S"word1" S" " S"word2" S" " S"word3" S"]"
format_quoted_string "plain" = "plain"
format_quoted_string "" = "\"\""
format_quoted_string "two words" = "\"t\""
format_quoted_string "tab\there" = "\"t\""
format_quoted_string "line\nbreak" = "\"l\""
format_quoted_string "q\"uote" = "\"q\""
format_quoted_string "'prime" = "\"'\""
buffer_is_empty new = true
buffer_is_empty 3 words = false
clear_buffer then empty = true
clone_buffer survives clear = "word1 word2 word3"
zone_depth two open = 2
zone_depth one closed = 1
default_width  = 80
line_format w=10 = "word1 w..."
marshal/unmarshal all docs, text w=20 equal = true
