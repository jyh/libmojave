serve None: port > 0  = true
connect 127.0.0.1: the client's peer port is the server's  = true
accept: the accepted peer port is the client's local port  = true
client -> server  = "ping"
server -> client  = "pong!"
connect to the closed port  = EXN Unix.Unix_error(Unix.ECONNREFUSED, "connect", "")
serve (Some port), the port just freed  = true
connect "localhost": the peer port  = true
  client -> server  = "byname"
connect "localhost" to the closed port  = EXN Unix.Unix_error(Unix.ECONNREFUSED, "connect", "")
