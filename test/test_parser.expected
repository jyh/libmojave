parse prog "1+2*3" = 7 via num num num mul add prog 
parse prog "2*3+4" = 10 via num num mul num add prog 
parse prog "(1+2)*3" = 9 via num num add paren num mul prog 
parse prog "8-3-2" = 3 via num num sub num sub prog 
parse prog "2^3^2" = 512 via num num num pow pow prog 
parse prog "2*3^2" = 18 via num num num pow mul prog 
parse prog "((7))" = 7 via num paren paren prog 
parse prog "7" = 7 via num prog 
parse prog "1+" = EXN Lm_parser.ParseError(_, "Syntax error on token $eof\nCurrent state:\n    e + . e\n   The next possible tokens are: num (")
parse prog "+1" = EXN Lm_parser.ParseError(_, "Syntax error on token +\nCurrent state:\n    . e $eof\n   The next possible tokens are: num (")
parse prog "1 2" = EXN Lm_parser.ParseError(_, "Syntax error on token num\nCurrent state:\n    e . $eof\n    e . + e\n    e . - e\n    e . * e\n    e . ^ e\n   The next possible tokens are: ^ * - + $eof")
parse prog "(1" = EXN Lm_parser.ParseError(_, "Syntax error on token $eof\nCurrent state:\n    ( e . )\n    e . + e\n    e . - e\n    e . * e\n    e . ^ e\n   The next possible tokens are: ) ^ * - +")
parse prog "" = EXN Lm_parser.ParseError(_, "Syntax error on token $eof\nCurrent state:\n    . e $eof\n   The next possible tokens are: num (")
parse s (s -> e, no eof in the production) "7" = EXN Lm_parser.ParseError(_, "Syntax error on token s\nCurrent state:\n    . e\n   The next possible tokens are: num (")
parse s (s -> e, no eof in the production) "1+2" = EXN Lm_parser.ParseError(_, "Syntax error on token s\nCurrent state:\n    . e\n   The next possible tokens are: num (")
parse e (recursive start symbol) "7" = EXN Lm_parser.ParseError(_, "Syntax error on token $eof\nCurrent state:\n    e . + e\n    e . - e\n    e . * e\n    e . ^ e\n   The next possible tokens are: ^ * - +")
parse e (recursive start symbol) "1+2" = EXN Lm_parser.ParseError(_, "Syntax error on token $eof\nCurrent state:\n    e . + e\n    e . - e\n    e . * e\n    e . ^ e\n   The next possible tokens are: ^ * - +")
parse locations "7" = num@0-1 prog@0-1 
parse locations "1+2" = num@0-1 num@2-3 add@0-3 prog@0-3 
parse locations "1+2*3" = num@0-1 num@2-3 num@4-5 mul@2-5 add@0-5 prog@0-5 
parse locations "(4)" = num@1-2 paren@0-3 prog@0-3 
parse locations "2 * 3" = num@0-1 num@4-5 mul@0-5 prog@0-5 
remove_production: b -> x removed "x" = EXN Lm_parser.ParseError(_, "Syntax error on token x\nCurrent state:\n    . e $eof\n   The next possible tokens are: b num (")
remove_production: b -> x never added "x" = EXN Lm_parser.ParseError(_, "Syntax error on token x\nCurrent state:\n    . e $eof\n   The next possible tokens are: b num (")
remove_production: b -> x removed "b" = 4
remove_production: b -> x never added "b" = 4
remove_production: b -> x removed "x+1" = EXN Lm_parser.ParseError(_, "Syntax error on token x\nCurrent state:\n    . e $eof\n   The next possible tokens are: b num (")
remove_production: b -> x never added "x+1" = EXN Lm_parser.ParseError(_, "Syntax error on token x\nCurrent state:\n    . e $eof\n   The next possible tokens are: b num (")
accept: prog -> S $eof, S -> a "a" = sa(a)
accept: prog -> S $eof, S -> a "aa" = sa(a)
accept: prog -> S $eof, S -> a "aaa" = sa(a)
accept: prog -> S $eof, S -> a "ab" = sa(a)
accept: prog -> S $eof, S -> a "" = EXN Lm_parser.ParseError(_, "Syntax error on token $eof\nCurrent state:\n    . S $eof\n   The next possible tokens are: a")
accept: prog -> S $eof, S -> a b "ab" = sab(a,b)
accept: prog -> S $eof, S -> a b "abab" = sab(a,b)
accept: prog -> S $eof, S -> a b "abc" = sab(a,b)
accept: prog -> a prog | b $eof "b" = pb(b,$eof)
accept: prog -> a prog | b $eof "ab" = pb(b,$eof)
accept: prog -> a prog | b $eof "aab" = pb(b,$eof)
accept: prog -> a prog | b $eof "abb" = EXN Lm_parser.ParseError(_, "Syntax error on token b\nCurrent state:\n    b . $eof\n   The next possible tokens are: $eof")
