parse_path [] "a/b/c" = ["a"; "b"; "c"]
parse_path [] "a//./b/" = ["a"; "b"]
parse_path [] "a/../b" = ["b"]
parse_path [] "../a" = ["a"]
parse_path [] "/abs/x" = ["abs"; "x"]
parse_path [] "" = []
parse_path ["usr"; "lib"] "x" = ["lib"; "usr"; "x"]
parse_path ["usr"; "lib"] "../x" = ["lib"; "x"]
parse_path ["usr"; "lib"] "/x" = ["x"]
build_path [] = "."
build_path ["a"] = "a"
build_path ["a"; "b"; "c"] = "a/b/c"
path_dir / path_file "a/b/c" = "a/b" "c"
path_dir / path_file "c" = "." "c"
path_dir / path_file "" = "." "."
path_dir / path_file "/usr/lib/x" = "usr/lib" "x"
path_dir / path_file "a/b/" = "a" "b"
with_output_file, with_input_file  = "hello"
with_input_file, f raises  = EXN Failure("boom")
open_in_path [missing; tmp]  = hello from the file
open_in_path [missing]  = EXN CantFind (the name)
