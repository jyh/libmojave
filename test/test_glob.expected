is_glob_string "abc" = false
is_glob_string "*.ml" = true
is_glob_string "a?c" = true
is_glob_string "[ab]c" = true
is_glob_string "{a,b}" = false
is_glob_string "a\\*b" = false
is_glob_string "~" = true
is_glob_string "" = false
glob_add_escaped "abc" = "abc"
glob_add_escaped "*?[]" = "\\*\\?\\[\\]"
glob_add_escaped "a b" = "a b"
glob_add_escaped "\\" = "\\"
glob "gfx/*.ml" = [] ["gfx/a.ml"; "gfx/b.ml"]
glob "gfx/*" = ["gfx/sub"] ["gfx/a.ml"; "gfx/b.ml"; "gfx/c.mli"]
glob "gfx/?.ml*" = [] ["gfx/a.ml"; "gfx/b.ml"; "gfx/c.mli"]
glob "gfx/[ab].ml" = [] ["gfx/a.ml"; "gfx/b.ml"]
glob "gfx/{a,c}.*" = [] ["gfx/a.ml"; "gfx/c.mli"]
glob "gfx/*/d.ml" = [] ["gfx/sub/d.ml"]
glob "gfx/none*" = EXN Failure("gfx/none*: bad match")
glob "gfx/a.ml" = [] ["gfx/a.ml"]
