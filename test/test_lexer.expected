lex "x1 + 23*(y)" = id:"x1" ws:" " op:"+" ws:" " num:"23" op:"*" lp:"(" id:"y" rp:")" EOF
lex "let x = \"a b\"" = id:"let" ws:" " id:"x" ws:" " op:"=" ws:" " str:"\"a b\"" EOF
lex "letter" = id:"letter" EOF
lex "let" = id:"let" EOF
lex "12ab" = num:"12" id:"ab" EOF
lex "" = EOF
lex "  " = ws:"  " EOF
lex "a$b" = id:"a" END Failure("Lm_lexer: lex: no clause matched")
lex "\"open" = END Failure("Lm_lexer: lex: no clause matched")
union, choose = min: second alone "let" = id
union, choose = min: union first second "let" = id
union, choose = max: second alone "let" = kw_let
union, choose = max: union first second "let" = kw_let
