; Pinning tests: each prints a library function's answers on chosen inputs,
; and the .expected file is that output as generated from the code at the
; time the test was written. A change in behaviour shows as a diff.
(library
 (name pin)
 (modules pin))

(tests
 (names test_string_util test_symbol test_num test_channel
  test_set_map test_printf test_lexer test_parser test_hash test_fmarshal
  test_list_util test_rformat test_array_util test_location test_splay_table test_rformat_backends test_rprintf test_thread_shell test_debug)
 (modules test_string_util test_symbol test_num test_channel
  test_set_map test_printf test_lexer test_parser test_hash test_fmarshal
  test_list_util test_rformat test_array_util test_location test_splay_table test_rformat_backends test_rprintf test_thread_shell test_debug)
 (libraries libmojave pin unix))

(test
 (name test_thread)
 (modules test_thread)
 (enabled_if (= %{profile} threads))
 (libraries libmojave pin))

(test
 (name test_thread_event)
 (modules test_thread_event)
 (enabled_if (= %{profile} threads))
 (libraries libmojave pin unix))

; Filenames and globbing are platform-dependent by design (separators,
; drives), so these two compare against a per-platform expected file.
(executables
 (names test_filename_util test_glob)
 (modules test_filename_util test_glob)
 (libraries libmojave pin unix))

(rule
 (with-stdout-to test_filename_util.output (run ./test_filename_util.exe)))

(rule
 (alias runtest)
 (enabled_if (<> %{os_type} Win32))
 (action (diff test_filename_util.expected test_filename_util.output)))

(rule
 (alias runtest)
 (enabled_if (= %{os_type} Win32))
 (action (diff test_filename_util.win32.expected test_filename_util.output)))

(rule
 (with-stdout-to test_glob.output (run ./test_glob.exe)))

(rule
 (alias runtest)
 (enabled_if (<> %{os_type} Win32))
 (action (diff test_glob.expected test_glob.output)))

(rule
 (alias runtest)
 (enabled_if (= %{os_type} Win32))
 (action (diff test_glob.win32.expected test_glob.output)))

; Lm_config.code has one C stub per mode, so this test runs as bytecode
; (byte_complete: the C stubs linked in) and as native code. The expected
; files differ only in the backend's name.
(executables
 (names test_config)
 (modules test_config)
 (modes byte_complete exe)
 (libraries libmojave))

(rule
 (with-stdout-to test_config.byte.output (run ./test_config.bc.exe)))

(rule
 (with-stdout-to test_config.native.output (run ./test_config.exe)))

(rule
 (alias runtest)
 (action (diff test_config.byte.expected test_config.byte.output)))

(rule
 (alias runtest)
 (action (diff test_config.native.expected test_config.native.output)))

; Lm_ctype's primitives follow the C library's locale tables. Under MSVC's
; C runtime, after setlocale(LC_CTYPE, ""), isprint('\t') is true; MinGW,
; Linux and macOS say false. So MSVC compares against its own file.
(executable
 (name test_ctype)
 (modules test_ctype)
 (libraries libmojave))

(rule
 (with-stdout-to test_ctype.output (run ./test_ctype.exe)))

(rule
 (alias runtest)
 (enabled_if (<> %{ocaml-config:ccomp_type} msvc))
 (action (diff test_ctype.expected test_ctype.output)))

(rule
 (alias runtest)
 (enabled_if (= %{ocaml-config:ccomp_type} msvc))
 (action (diff test_ctype.msvc.expected test_ctype.output)))
