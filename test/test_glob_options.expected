braces x{a,b}y = ok dirs [] files ["xay"; "xby"]
GlobNoBraces x{a,b}y = ok dirs [] files ["x{a,b}y"]
escape a\\* (a literal a*: no such file) = dirs [] files ["a*"]
GlobNoEscape sub\\k* = ok dirs [] files ["sub/k.ml"; "sub/k.tmp"; "sub/keep"]
GlobNoEscape a\\* (= a/*) = EXN Failure("a\\*: bad match")
escape a\\b (= a/b) = dirs [] files ["a/b"]
GlobHomeDir ~/h* = ok dirs [] files ["<F>/home/h1"; "<F>/home/h2.txt"]
GlobHomeDir ~ = ok dirs ["<F>/home"] files []
GlobNoTilde ~ = ok dirs [] files ["~"]
escaped tilde \\~ = ok dirs [] files ["~"]
GlobIgnoreFun *.ml, ignore a* = ok dirs [] files ["b.ml"]
GlobAllowFun *.ml, allow a* = ok dirs [] files ["a.ml"]
GlobCVSIgnore sub/* (root = the fixture) = ok dirs ["sub/d"; "sub/e"] files ["sub/corefile"; "sub/k.ml"; "sub/keep"]
GlobCVSIgnore sub/* (cwd = the fixture, root = .) = ok dirs ["sub/d"; "sub/e"] files ["sub/corefile"; "sub/k.ml"; "sub/keep"]
no GlobCVSIgnore sub/* = dirs ["sub/d"; "sub/e"] files ["sub/core"; "sub/corefile"; "sub/it's"; "sub/k.ml"; "sub/k.tmp"; "sub/keep"]
subdirs_of_dirs sub = ok ["sub"; "sub/d"; "sub/e"]
GlobProperSubdirs subdirs_of_dirs sub = ok ["sub/d"; "sub/e"]
