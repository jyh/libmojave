html plain w=80 = "hello world"
html+tagger plain w=80 = "hello world"
tex plain w=80 = "\\texfalse\\iftex%\nhello\\ world\\\\\n\\fi\\enmptab%\n"
html plain w=10 = "hello world"
html+tagger plain w=10 = "hello world"
tex plain w=10 = "\\texfalse\\iftex%\nhello\\ world\\\\\n\\fi\\enmptab%\n"
html html specials w=80 = "a&lt;b &amp; c&gt;d &quot;q&quot;"
html+tagger html specials w=80 = "a&lt;b &amp; c&gt;d &quot;q&quot;"
tex html specials w=80 = "\\texfalse\\iftex%\na\\lt b\\ \\char38\\ c\\gt d\\ \"q\"\\\\\n\\fi\\enmptab%\n"
html html specials w=10 = "a&lt;b &amp; c&gt;d &quot;q&quot;"
html+tagger html specials w=10 = "a&lt;b &amp; c&gt;d &quot;q&quot;"
tex html specials w=10 = "\\texfalse\\iftex%\na\\lt b\\ \\char38\\ c\\gt d\\ \"q\"\\\\\n\\fi\\enmptab%\n"
html tex specials w=80 = "\\x {y} $z$ a_b c^d 10% #1 ~"
html+tagger tex specials w=80 = "\\x {y} $z$ a_b c^d 10% #1 ~"
tex tex specials w=80 = "\\texfalse\\iftex%\n\\char92 x\\ \\{y\\}\\ \\char36 z\\char36\\ a\\_b\\ c\\char94 d\\ 10\\char37\\ \\char35 1\\ ~\\\\\n\\fi\\enmptab%\n"
html tex specials w=10 = "\\x {y} $z$ a_b c^d 10% #1 ~"
html+tagger tex specials w=10 = "\\x {y} $z$ a_b c^d 10% #1 ~"
tex tex specials w=10 = "\\texfalse\\iftex%\n\\char92 x\\ \\{y\\}\\ \\char36 z\\char36\\ a\\_b\\ c\\char94 d\\ 10\\char37\\ \\char35 1\\ ~\\\\\n\\fi\\enmptab%\n"
html szone w=80 = "w1 w2 w3 w4 w5 w6"
html+tagger szone w=80 = "w1 w2 w3 w4 w5 w6"
tex szone w=80 = "\\texfalse\\iftex%\nw1\\ w2\\ w3\\ w4\\ w5\\ w6\\\\\n\\fi\\enmptab%\n"
html szone w=10 = "w1\n<br>\nw2\n<br>\nw3\n<br>\nw4 w5 w6"
html+tagger szone w=10 = "w1\n<br>\nw2\n<br>\nw3\n<br>\nw4 w5 w6"
tex szone w=10 = "\\texfalse\\iftex%\nw1\\\\\nw2\\\\\nw3\\\\\nw4\\ w5\\ w6\\\\\n\\fi\\enmptab%\n"
html pushm w=80 = "w1 w2 w3 w4 w5 w6"
html+tagger pushm w=80 = "w1 w2 w3 w4 w5 w6"
tex pushm w=80 = "\\texfalse\\iftex%\nw1\\ w2\\ w3\\ w4\\ w5\\ w6\\\\\n\\fi\\enmptab%\n"
html pushm w=10 = "w1\n<br>\n<span style=\"visibility:hidden\">w1</span>w2\n<br>\n<span style=\"visibility:hidden\">w1</span>w3\n<br>\n<span style=\"visibility:hidden\">w1</span>w4\n<br>\n<span style=\"visibility:hidden\">w1</span>w5 w6"
html+tagger pushm w=10 = "w1\n<br>\n<span style=\"visibility:hidden\">w1</span>w2\n<br>\n<span style=\"visibility:hidden\">w1</span>w3\n<br>\n<span style=\"visibility:hidden\">w1</span>w4\n<br>\n<span style=\"visibility:hidden\">w1</span>w5 w6"
tex pushm w=10 = "\\texfalse\\iftex%\nw1\\\\\n\\phantom{w1}w2\\\\\n\\phantom{w1}w3\\\\\n\\phantom{w1}w4\\\\\n\\phantom{w1}w5\\ w6\\\\\n\\fi\\enmptab%\n"
html newline w=80 = "a\n<br>\nb"
html+tagger newline w=80 = "a\n<br>\nb"
tex newline w=80 = "\\texfalse\\iftex%\na\\\\\nb\\\\\n\\fi\\enmptab%\n"
html newline w=10 = "a\n<br>\nb"
html+tagger newline w=10 = "a\n<br>\nb"
tex newline w=10 = "\\texfalse\\iftex%\na\\\\\nb\\\\\n\\fi\\enmptab%\n"
html tzone w=80 = "let x"
html+tagger tzone w=80 = "<span class=\"kw\">let</span> x"
tex tzone w=80 = "\\texfalse\\iftex%\n\\kw{let}\\ x\\\\\n\\fi\\enmptab%\n"
html tzone w=10 = "let x"
html+tagger tzone w=10 = "<span class=\"kw\">let</span> x"
tex tzone w=10 = "\\texfalse\\iftex%\n\\kw{let}\\ x\\\\\n\\fi\\enmptab%\n"
html izone w=80 = "v<hidden>w"
html+tagger izone w=80 = "v<hidden>w"
tex izone w=80 = "\\texfalse\\iftex%\nv<hidden>w\\\\\n\\fi\\enmptab%\n"
html izone w=10 = "v<hidden>w"
html+tagger izone w=10 = "v<hidden>w"
tex izone w=10 = "\\texfalse\\iftex%\nv<hidden>w\\\\\n\\fi\\enmptab%\n"
escape "" = ""
escape "plain" = "plain"
escape "<a href=\"x\">" = "&lt;a href=&quot;x&quot;&gt;"
escape "a & b" = "a &amp; b"
escape "it's" = "it's"
escape "caf\195\169" = "caf\195\169"
