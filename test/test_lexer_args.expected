lex \(a*\)b (arity 1) "aab" = "aab" ["aa"]
lex \(a*\)b (arity 1) "b" = "b" [""]
lex \(a\)*b (arity 1) "aab" = "aab" ["a"]
lex \(a\)*b (arity 1) "ab" = "ab" ["a"]
lex \(a\)*b (arity 1) "b" = "b" [""]
lex \([ab]\)*c (arity 1) "abc" = "abc" ["b"]
lex \([ab]\)*c (arity 1) "c" = "c" [""]
lex \(a*\)\(a*\) (arity 2) "aaa" = "aaa" ["aaa"; ""]
lex \(a\(b\)\)c (arity 2) "abc" = "abc" ["ab"; "b"]
lex \(\(a\)b\)* (arity 2) "abab" = "abab" ["ab"; "a"]
lex \(\(a\)b\)* (arity 2) "" = "" [""; ""]
lex x\(a\)?\(b\) (arity 2) "xab" = EXN Failure("Lm_lexer: Regular expression has mismatched argument counts")
lex x\(a\)?\(b\) (arity 2) "xb" = EXN Failure("Lm_lexer: Regular expression has mismatched argument counts")
lex \(a\)|\(b\) (arity 1) "a" = "a" ["a"]
lex \(a\)|\(b\) (arity 1) "b" = "b" ["b"]
lex \(a\)x|\(b\)y (arity 1) "ax" = "ax" ["a"]
lex \(a\)x|\(b\)y (arity 1) "by" = "by" ["b"]
lex \(a\)\(b\)|\(c\)\(d\) (arity 2) "ab" = "ab" ["a"; "b"]
lex \(a\)\(b\)|\(c\)\(d\) (arity 2) "cd" = "cd" ["c"; "d"]
lex q\(\(a\)|\(b\)\)* (arity 2) "q" = "q" [""; ""]
lex q\(\(a\)|\(b\)\)* (arity 2) "qab" = "qab" ["b"; "b"]
lex q\(\(a\)|\(b\)\)* (arity 2) "qba" = "qba" ["a"; "a"]
lex "\(\\.|[^"]*\)" (arity 1) "\"abc\"" = "\"abc\"" ["abc"]
lex "\(\\.|[^"]*\)" (arity 1) "\"\"" = "\"\"" [""]
