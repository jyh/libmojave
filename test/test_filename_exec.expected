mkdirhier a/b/c (relative)  = unit
  a/b/c is a directory  = true
mkdirhier a/b/c again  = unit
mkdirhier an absolute path  = unit
  abs/x is a directory  = true
mkdirhier through a regular file  = EXN Unix.Unix_error(Unix.ENOTDIR, "Lm_filename_util.mkdirhier", "./test_filename_exec.dir/a/file")
lsdir a (sorted)  = ["b"; "file"]
lsdir a missing directory  = EXN Unix.Unix_error(Unix.ENOENT, "opendir", "test_filename_exec.dir/none")
is_executable x755 = Some test_filename_exec.dir/bin/x755 (access X_OK: yes)
is_executable x644 = None (access X_OK: no)
is_executable x100 = Some test_filename_exec.dir/bin/x100 (access X_OK: yes)
is_executable x010 = None (access X_OK: no)
is_executable x001 = None (access X_OK: no)
is_executable x000 = None (access X_OK: no)
is_executable missing = None (access X_OK: no)
is_executable a directory  = None
which ./<bin>/x755 (relative, with a separator)  = <cwd>/./test_filename_exec.dir/bin/x755
which <bin>/x644 (not executable)  = EXN Not_found
which an absolute path  = <cwd>/test_filename_exec.dir/bin/x755
which an absolute missing path  = EXN Not_found
which sh, found on the load-time PATH  = true
which a name on no PATH  = EXN Not_found
after PATH=<bin>:<abs/x>: which x755  = EXN Not_found
  where x755  = ["test_filename_exec.dir/bin/x755"; "test_filename_exec.dir/abs/x/x755"]
  where x644  = []
  where a/x755 (a separator)  = EXN Invalid_argument("Lm_filename_util.where")
which_dir <bin> x755 (a bare name)  = EXN Not_found
which_dir <bin> ./x755  = test_filename_exec.dir/bin/./x755
which_dir <bin> ./x644  = EXN Not_found
which_dir <bin> sh (a bare name, the cache)  = true
